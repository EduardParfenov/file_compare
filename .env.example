FLASK_APP=app
FLASK_DEBUG=1
SECRET_KEY=change-me

# Один сервер обслуживает обе роли: классификацию фрагментов и чтение
# страниц сканов. Заполните значения для своего развёртывания: шаблон
# намеренно не содержит боевых адресов и ключей.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Доп. параметры тела запроса к LLM (JSON, опционально).
# Пример для qwen3 (отключение thinking-режима):
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY=

# Настройки роли чтения страниц. Модель та же (LLM_MODEL), различаются
# только параметры вызова.
# OCR_TIMEOUT=120
# OCR_CONCURRENCY=4
# OCR_PROMPT_VERSION=v1

# Параметры работы с PDF.
# PDF_RENDER_DPI=200
# PDF_CROPS_MAX_BYTES=4194304

# Уровень журнала: CRITICAL, ERROR, WARNING, INFO, DEBUG.
# По умолчанию WARNING — журнал не мешает повседневной работе, а диагностика
# включается значением DEBUG. Неизвестное значение не мешает запуску:
# применяется уровень по умолчанию. Пишутся причины проглоченных сбоев;
# содержимое документов и секреты не логируются.
# LOG_LEVEL=WARNING

UPLOAD_DIR=uploads
# Лимит загрузки: рассчитан на многостраничный скан (~128 МБ)
MAX_CONTENT_LENGTH=134217728
# Суммарный лимит изображений, извлекаемых из документа (байты)
MAX_IMAGES_TOTAL_BYTES=10485760
ALLOWED_EXTENSIONS=.docx,.pdf
